@article{figge_adsorptionsmittel_1987,
	title = {Adsorptionsmittel zur Anreicherung von organischen Luftinhaltsstoffen},
	volume = {327},
	% issn = {1618-2650},
	% url = {https://doi.org/10.1007/BF00491828},
	doi = {10.1007/BF00491828},
	abstract = {26 porous adsorbents were tested with regard to their suitability for the enrichment of organic atmospheric trace compounds. This was done by the use of 29 organic test substances belonging to different classes and differing also in their physical-chemical properties. The retention times of the organic compounds were determined experimentally by use of a gas-chromatographic method (elution method) at at least three different temperatures. From the retention times the specific retention volumes and the specific break-through volumes were calculated with respect to an adsorption temperature of 30 °C.},
	pages = {261--278},
	number = {3},
	journaltitle = {Fresenius' Zeitschrift für analytische Chemie},
	shortjournal = {Z. Anal. Chem.},
